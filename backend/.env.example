APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_football
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" no envía nada: deja el correo (con el enlace de restablecer contraseña) en storage/logs/laravel.log.
# Para enviar de verdad: MAIL_MAILER=resend, la clave de Resend y un remitente de un dominio verificado.
MAIL_MAILER=log
RESEND_API_KEY=
# URL de la SPA: a donde apuntan los enlaces de los correos
FRONTEND_URL=http://localhost:5173
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Captcha de Cloudflare Turnstile (opcional). Vacío = apagado: registro y recuperar contraseña no lo piden.
# Para activarlo pon aquí el secreto y en frontend/.env la clave del sitio (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# football-data.org: el token se pide gratis en https://www.football-data.org/client/register
FOOTBALL_DATA_URL=https://api.football-data.org/v4/
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_RATE_LIMIT=9
FOOTBALL_DATA_TIMEOUT=10
FOOTBALL_DATA_FRESH_HOURS=24

VITE_APP_NAME="${APP_NAME}"
