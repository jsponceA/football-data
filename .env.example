# Variables de Docker Compose. Copia este archivo a ".env" y completa lo que falta:
#   cp .env.example .env
# Nunca subas el .env: tiene secretos.

# ---------- Obligatorio ----------
# Se pide gratis en https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# ---------- Direcciones ----------
# Con estos valores el proyecto abre en local: SPA http://localhost:8080 y API http://localhost:8000
# APP_URL es la dirección pública de la API (de ahí salen las URL de las fotos y a ella apunta la SPA);
# FRONTEND_URL es la de la SPA (enlaces de los correos y el único origen que acepta CORS).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
FRONT_PORT=8080
API_PORT=8000

# "local" deja abierta la documentación de la API en /docs/api; con "production" se cierra
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=debug

# ---------- Base de datos ----------
POSTGRES_DB=db_football
POSTGRES_USER=football
POSTGRES_PASSWORD=football

# Contraseña de admin@example.com y consulta@example.com. Solo se aplica la primera vez, con la base vacía.
SEED_USER_PASSWORD=password

# Vacía: el contenedor genera una y la conserva. Para fijarla: php artisan key:generate --show
APP_KEY=

# ---------- Correo ----------
# "log" no envía nada: el enlace de restablecer contraseña aparece en "docker compose logs app".
# Para enviar de verdad: MAIL_MAILER=resend, la clave de Resend y un remitente de un dominio verificado.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com

# ---------- Captcha de Cloudflare Turnstile (opcional) ----------
# Vacíos = apagado. Hay claves de prueba en https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# ---------- Solo para el VPS ----------
# Con el Nginx del servidor delante, cambia lo de arriba por algo así:
#   APP_URL=https://api.midominio.com
#   FRONTEND_URL=https://app.midominio.com
#   APP_ENV=production
#   LOG_LEVEL=warning
#   POSTGRES_PASSWORD=<una contraseña propia>
#   SEED_USER_PASSWORD=<una contraseña propia>
# y descomenta estas dos: los puertos quedan solo en localhost y los contenedores se reinician solos.
# BIND_ADDRESS=127.0.0.1
# RESTART_POLICY=unless-stopped
