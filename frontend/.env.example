VITE_API_URL=http://localhost:8000/api
# Captcha de Cloudflare Turnstile (opcional). Vacío = apagado. Con la clave del sitio aquí,
# pon el secreto en backend/.env (TURNSTILE_SECRET). Claves de prueba que siempre aprueban:
#   sitio  1x00000000000000000000AA
#   secreto 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
